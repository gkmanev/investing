DEBUG=True
APP_ENV=development
SECRET_KEY=change-me

# Local development defaults to SQLite when APP_ENV=development and no
# database env vars are set.
# Optional if you want Postgres locally instead:
# DATABASE_URL=postgresql://investing:investing@127.0.0.1:5432/investing
# Optional if you want SQLite via DATABASE_URL explicitly:
# DATABASE_URL=sqlite:///db.sqlite3

OPENAI_API_KEY=
RAPIDAPI_KEY=
FINANCIAL_MODELING_API_KEY=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
DAILY_BRIEF_SEND_HOUR_UTC=12
DAILY_BRIEF_SEND_MINUTE_UTC=0

AUTH_ALLOW_PUBLIC_REGISTRATION=False
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/auth/
AUTH_EMAIL_VERIFICATION_HOURS=24
AUTH_RESEND_COOLDOWN_SECONDS=60
FRONTEND_BASE_URL=http://localhost:4173
AUTH_VERIFY_EMAIL_PATH=/verify-email

# Configure Resend in production to send over HTTPS instead of SMTP.
# If RESEND_API_KEY is unset, Django falls back to the configured email backend.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_FROM_EMAIL=admin@putpulse.com

# Optional SMTP fallback. For local development, Django falls back to
# the console email backend when APP_ENV is not production unless EMAIL_BACKEND
# is overridden.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=admin@putpulse.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=admin@putpulse.com
